# Anytype REST API credentials for Hermes's own bot identity — NOT your personal
# desktop app's key. See docs/design.md Section 10 for how to create a separate
# "hermes" account via anytype-cli, invite it into your space, and mint this key
# against that account's own node (so messages post as "Hermes", not as you).
ANYTYPE_API_KEY=

# Base URL of the node running the "hermes" identity.
#
# If Hermes and the anytype-cli bot node (docker-compose.anytype-bot.yml)
# both run in Docker but as SEPARATE Compose projects (the normal setup --
# they're two different compose files), 127.0.0.1 from inside Hermes's own
# container is Hermes's own loopback, not the bot node's. Use
# host.docker.internal instead, which reaches the host's published ports
# from inside a container (confirmed working this way on Docker Desktop for
# Mac; unverified on Linux Docker hosts, where the equivalent is usually
# --add-host=host.docker.internal:host-gateway or the host's real IP).
#
# 127.0.0.1 is only correct if Hermes itself is running outside Docker, or
# in the exact same network namespace as the bot node.
ANYTYPE_API_BASE_URL=http://host.docker.internal:31012

# The target space's ID (from `list-chats`/space settings), not a human-readable name.
ANYTYPE_SPACE_ID=

# Optional, but strongly recommended: the "hermes" identity's own Anytype
# account id (printed during `anytype auth create` -- see docker-compose
# .anytype-bot.yml's usage comment / docs/design.md Section 10).
#
# Confirmed live (beta round 11): a real UI @mention embeds the mentioned
# party's *display name* as literal text -- e.g. "Untitled" for a bot whose
# profile name was never set -- plus a separate structural mention mark
# referencing their real account id. Without ANYTYPE_ACCOUNT_ID, the plugin
# can only detect mentions via a literal "@hermes" substring in the message
# text, which real UI-driven @mentions won't contain. Set this to get real
# @mention detection working.
ANYTYPE_ACCOUNT_ID=
